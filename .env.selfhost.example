# 自己部署(服务器代填 OpenAI key)时用:复制成 .env.selfhost 再 `npm run deploy:selfhost`
# 页面在没填 key 时请求的同站转发路径;转发和登录要自己在服务器上配(例如 Caddy 反代 api.openai.com 并加 Authorization 头,前面挡一层登录)
VITE_SERVER_API=/openai/v1
# deploy/selfhost.sh 用:ssh 主机名和网站目录(页面发布在该目录,例如 https://example.com/live/)
DEPLOY_HOST=my-server
DEPLOY_DIR=/var/www/site/live
